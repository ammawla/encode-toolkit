// ENCODE RNA-seq Pipeline Configuration
// Profiles: local (Docker), slurm (Singularity), gcp, aws
// NOTE: STAR requires 32GB+ RAM for human genome index

params {
    max_cpus   = 16
    max_memory = '64.GB'
    max_time   = '24.h'

    // Google Cloud settings (only read by the gcp profile)
    gcp_project  = null
    gcp_location = 'us-central1'

    // Container image. It is built from the Dockerfile that ships with this skill:
    //   docker build -t encode-toolkit/pipeline-rnaseq:1.0.0 scripts/
    // For the slurm profile, convert it once and pass the image file:
    //   singularity build pipeline-rnaseq.sif docker-daemon://encode-toolkit/pipeline-rnaseq:1.0.0
    //   nextflow run main.nf -profile slurm --container /path/to/pipeline-rnaseq.sif ...
    // For the gcp and aws profiles, push the image to a registry you control and
    // pass its full name with --container.
    container  = 'encode-toolkit/pipeline-rnaseq:1.0.0'
}

profiles {
    local {
        docker.enabled = true
        process {
            container = params.container
            cpus   = 4
            memory = '16.GB'
            withName: 'STAR_ALIGN'      { cpus = 8;  memory = '36.GB' }
            withName: 'RSEM_QUANT'      { cpus = 8;  memory = '16.GB' }
            withName: 'KALLISTO_QUANT'   { cpus = 4;  memory = '8.GB'  }
            withName: 'SIGNAL_TRACKS'    { cpus = 2;  memory = '8.GB'  }
            withName: 'RSEQC'           { cpus = 2;  memory = '8.GB'  }
            withName: 'MULTIQC'         { cpus = 1;  memory = '4.GB'  }
        }
    }

    slurm {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            container = params.container
            executor  = 'slurm'
            queue     = 'normal'
            cpus      = 4
            memory    = '16.GB'
            time      = '4.h'
            withName: 'STAR_ALIGN'      { cpus = 8;  memory = '36.GB'; time = '8.h'  }
            withName: 'RSEM_QUANT'      { cpus = 8;  memory = '16.GB'; time = '4.h'  }
            withName: 'KALLISTO_QUANT'   { cpus = 4;  memory = '8.GB';  time = '1.h'  }
            withName: 'SIGNAL_TRACKS'    { cpus = 2;  memory = '8.GB';  time = '2.h'  }
            withName: 'RSEQC'           { cpus = 2;  memory = '8.GB';  time = '2.h'  }
            withName: 'MULTIQC'         { cpus = 1;  memory = '4.GB';  time = '1.h'  }
        }
    }

    gcp {
        docker.enabled = true
        process {
            container = params.container
            executor  = 'google-batch'
            cpus      = 4
            memory    = '16.GB'
            disk      = '100.GB'
            withName: 'STAR_ALIGN'      { cpus = 8;  memory = '36.GB'; disk = '200.GB'; machineType = 'n1-highmem-8' }
            withName: 'RSEM_QUANT'      { cpus = 8;  memory = '16.GB'; disk = '100.GB' }
            withName: 'KALLISTO_QUANT'   { cpus = 4;  memory = '8.GB' }
            withName: 'SIGNAL_TRACKS'    { cpus = 2;  memory = '8.GB' }
        }
        google {
            project    = params.gcp_project
            location   = params.gcp_location
            batch.spot = true
        }
    }

    aws {
        docker.enabled = true
        process {
            container = params.container
            executor  = 'awsbatch'
            queue     = params.aws_queue ?: 'default'
            cpus      = 4
            memory    = '16.GB'
            withName: 'STAR_ALIGN'      { cpus = 8;  memory = '36.GB' }
            withName: 'RSEM_QUANT'      { cpus = 8;  memory = '16.GB' }
            withName: 'KALLISTO_QUANT'   { cpus = 4;  memory = '8.GB'  }
        }
        aws {
            region = params.aws_region ?: 'us-east-1'
            batch {
                cliPath = '/home/ec2-user/miniconda/bin/aws'
                volumes = '/tmp'
            }
        }
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
}
